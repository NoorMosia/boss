---
import portrait from '../../assets/artist/visuals/pe3.jpg';
---

<section class="hero section container">
  <div class="hero-content">
    <h1 class="hero-tagline">
      <span class="hero-word">Melody</span>
      <span class="hero-word">meets</span>
      <span class="hero-word">lyricism.</span>
    </h1>
  </div>

  <div class="hero-portrait-wrapper">
    <img
      src={portrait.src}
      alt="Boss Reminisce portrait"
      class="hero-portrait"
      width="500"
      height="667"
      loading="eager"
    />
  </div>
</section>
