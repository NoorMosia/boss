---
import sessionsData from '../content/sessions.json';

const sessions = sessionsData.sessions;

function formatDate(dateStr: string): string {
  const date = new Date(dateStr + 'T00:00:00');
  return date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  });
}

function formatDay(dateStr: string): string {
  const date = new Date(dateStr + 'T00:00:00');
  return date.toLocaleDateString('en-GB', { day: 'numeric' });
}

function formatMonth(dateStr: string): string {
  const date = new Date(dateStr + 'T00:00:00');
  return date.toLocaleDateString('en-GB', { month: 'short' }).toUpperCase();
}
---

<section id="sessions" class="section container">
  <h2 class="section-heading">Upcoming Sessions</h2>

  {sessions.length > 0 ? (
    <div class="timeline" data-timeline>
      <div class="timeline-line" data-timeline-line></div>
      {sessions.map(session => (
        <div class="timeline-item" data-animate>
          <div class="timeline-dot"></div>
          <div class="timeline-date">
            <span class="timeline-day">{formatDay(session.date)}</span>
            <span class="timeline-month">{formatMonth(session.date)}</span>
          </div>
          <div class="timeline-content">
            <span class="timeline-title">{session.title}</span>
            <span class="timeline-location">{session.location}</span>
            <span class="timeline-description">{session.description}</span>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <p class="sessions-empty">New sessions coming soon.</p>
  )}
</section>
