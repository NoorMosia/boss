---
import cover1 from '../../assets/artist/visuals/albumCover1.jpg';
import cover2 from '../../assets/artist/visuals/albumCover2.jpg';
import cover3 from '../../assets/artist/visuals/albumCover3.jpg';
import cover4 from '../../assets/artist/visuals/albumCover4.jpg';

const tracks = [
  { id: 'track-1', title: 'Soze Balunge (ft Lxndi)', cover: cover1.src },
  { id: 'track-2', title: 'Boys Do Cry', cover: cover2.src },
  { id: 'track-3', title: 'Touch the Sky', cover: cover3.src },
  { id: 'track-4', title: 'Touch the Sky', cover: cover4.src },
];
---

<section id="discography" class="section container">
  <h2 class="section-heading">Discography</h2>
  <div class="discography">
    <div class="deck-wrapper" data-deck>
      {tracks.map((track, i) => (
        <div
          class="deck-card"
          data-card
          data-track-id={track.id}
          style={`z-index: ${tracks.length - i}`}
        >
          <img src={track.cover} alt={`${track.title} album cover`} width="360" height="360" />
          <span class="deck-card-title">{track.title}</span>
        </div>
      ))}
    </div>

    <div class="player-section">
      <div class="player" data-player>

        <div class="player-waveform" data-player-waveform>
          {Array.from({ length: 32 }).map(() => (
            <div class="player-waveform-bar" style={`height: ${Math.random() * 24 + 8}px`}></div>
          ))}
        </div>

        <div class="player-progress-wrapper" data-player-progress>
          <div class="player-progress" data-player-progress-fill></div>
        </div>

        <div class="player-transport">
          <button class="deck-btn" data-deck-prev aria-label="Previous track">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="15 18 9 12 15 6" />
            </svg>
          </button>
          <button class="player-play" data-player-play aria-label="Play">
            <svg viewBox="0 0 24 24" class="play-icon">
              <polygon points="6,3 20,12 6,21" />
            </svg>
            <svg viewBox="0 0 24 24" class="pause-icon" style="display:none">
              <rect x="6" y="4" width="4" height="16" />
              <rect x="14" y="4" width="4" height="16" />
            </svg>
          </button>
          <button class="deck-btn" data-deck-next aria-label="Next track">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 6 15 12 9 18" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
